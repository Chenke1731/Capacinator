# E2E Test Environment Configuration
NODE_ENV=e2e
# Align with the actual e2e runtime: NODE_ENV=e2e uses .e2e-data/e2e-test.db
# (src/server/database/init-e2e.ts), and ports must match E2E_PORTS in
# tests/e2e/helpers/port-cleanup.ts — never 3110/3120 (dev stack).
DATABASE_URL=sqlite:./.e2e-data/e2e-test.db
DB_FILENAME=e2e-test.db
PORT=3111
CLIENT_PORT=3122

# Encryption key for GitHubConnectionService (E2E testing only)
ENCRYPTION_KEY=e2e-test-encryption-key-32-bytes!

# Disable features that might interfere with tests
DISABLE_AUTH=false
DISABLE_NOTIFICATIONS=true

# Enable audit service for E2E tests
AUDIT_ENABLED=true
AUDIT_MAX_HISTORY_ENTRIES=1000
AUDIT_RETENTION_DAYS=365
AUDIT_ENABLED_TABLES=people,projects,roles,assignments,availability,project_assignments,scenario_project_assignments,project_phases_timeline,scenarios,scenario_merge_conflicts
AUDIT_SENSITIVE_FIELDS=password,token,secret,key,hash