#!/bin/sh
# 物理闸门: 语法错误不能提交(不查风格,只查能不能编译)
STAGED_TS=$(git diff --cached --name-only -- '*.ts' '*.tsx' | head -1)
STAGED_CSS=$(git diff --cached --name-only -- '*.css' | head -1)
STAGED_SPEC=$(git diff --cached --name-only -- 'tests/e2e/**/*.ts' | head -1)

# migration 不可变守卫(024 事故防重演): 已提交的 migration 改动即拦截
echo "── Migration immutability ──"
node scripts/check-migrations-immutable.mjs
if [ $? -ne 0 ]; then
  echo "MIGRATION MUTATION — commit blocked"
  exit 1
fi

if [ -n "$STAGED_CSS" ]; then
  echo "── CSS changed, checking syntax ──"
  node -e "
    const postcss = require('postcss');
    const css = require('fs').readFileSync('client/src/App.css', 'utf8');
    try { postcss.parse(css, { from: 'App.css' }); console.log('✓ CSS parseable'); }
    catch(e) { console.error('✗ ' + e.message); process.exit(1); }
  "
  if [ $? -ne 0 ]; then
    echo "CSS PARSE ERROR — commit blocked"
    exit 1
  fi
fi

if [ -n "$STAGED_TS" ]; then
  echo "── TS/TSX changed, running typecheck (root) ──"
  npx tsc --noEmit 2>/dev/null
  if [ $? -ne 0 ]; then
    echo "✗ TypeScript errors — commit blocked"
    exit 1
  fi

  echo "── Client typecheck (budget) ──"
  node scripts/client-typecheck-budget.mjs
  if [ $? -ne 0 ]; then
    echo "✗ Client typecheck budget exceeded — commit blocked"
    exit 1
  fi
fi

if [ -n "$STAGED_SPEC" ]; then
  echo "── Spec typecheck (budget + zero-tolerance mines) ──"
  node scripts/spec-typecheck-budget.mjs
  if [ $? -ne 0 ]; then
    echo "✗ Spec typecheck — commit blocked"
    exit 1
  fi
fi

# 收集账本闸（2026-09-25 第三方评审裁决）: spec 或 playwright 配置变更时，
# 精确计数必须与 floor 一致——漂移（双向）不允许提交。P2/P3 加了 21 条红线
# 测试却没人同步 ledger，守卫第一次实战就抓住了自己人。合法变更 =
# 同一提交里更新 tests/e2e/.collection-floor.json。
STAGED_E2E_CFG=$(git diff --cached --name-only -- 'playwright.config.ts' 'playwright.scenario.config.ts' | head -1)
if [ -n "$STAGED_SPEC" ] || [ -n "$STAGED_E2E_CFG" ]; then
  echo "── E2e collection ledger (exact counts, ~40s) ──"
  node scripts/check-collection.mjs
  if [ $? -ne 0 ]; then
    echo "✗ Collection drift — commit blocked"
    echo "  If the change is intentional, update tests/e2e/.collection-floor.json"
    echo "  in THIS commit. Drift in EITHER direction is a ledger break."
    exit 1
  fi
fi

echo "✓ pre-commit passed"
