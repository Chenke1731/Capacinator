#!/bin/sh
# 物理闸门: 语法错误不能提交(不查风格,只查能不能编译)
STAGED_TS=$(git diff --cached --name-only -- '*.ts' '*.tsx' | head -1)
STAGED_CSS=$(git diff --cached --name-only -- '*.css' | head -1)
STAGED_SPEC=$(git diff --cached --name-only -- 'tests/e2e/**/*.ts' | head -1)

# migration 不可变守卫(024 事故防重演): 已提交的 migration 改动即拦截
echo "── Migration immutability ──"
node scripts/check-migrations-immutable.mjs
if [ $? -ne 0 ]; then
  echo "MIGRATION MUTATION — commit blocked"
  exit 1
fi

if [ -n "$STAGED_CSS" ]; then
  echo "── CSS changed, checking syntax (all client CSS, not just App.css) ──"
  # 2026-10-17 修复:旧版固定只读 App.css——People.css 的多余 } 直接漏网
  # 推上 origin,Vite 构建即炸。CSS 语法是跨文件性质,全量扫(量小,<1s)
  node -e "
    const postcss = require('postcss');
    const fs = require('fs');
    const path = require('path');
    const glob = (dir) => fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
      const p = path.join(dir, e.name);
      return e.isDirectory() ? glob(p) : (p.endsWith('.css') ? [p] : []);
    });
    const files = glob('client/src');
    let bad = 0;
    for (const f of files) {
      if (!fs.statSync(f).isFile()) continue;
      const css = fs.readFileSync(f, 'utf8');
      try { postcss.parse(css, { from: f }); }
      catch (e) { console.error('✗ ' + f + ': ' + e.message); bad = 1; }
    }
    if (bad) process.exit(1);
    console.log('✓ all CSS parseable (' + files.length + ' files)');
  "
  if [ $? -ne 0 ]; then
    echo "CSS PARSE ERROR — commit blocked"
    exit 1
  fi
fi

if [ -n "$STAGED_TS" ]; then
  echo "── TS/TSX changed, running typecheck (root) ──"
  npx tsc --noEmit 2>/dev/null
  if [ $? -ne 0 ]; then
    echo "✗ TypeScript errors — commit blocked"
    exit 1
  fi

  # 生产配置独立跑(strict:false 与根配置不同——2026-10-16 曾漏网:
  # BackfillParseResult 判别收窄在 strict 下通过、在生产配置下失败,
  # npm run build 断而 pre-commit 全绿)
  STAGED_SERVER_TS=$(echo "$STAGED_TS" | grep -c "^src/server/" || true)
  if [ "$STAGED_SERVER_TS" -gt 0 ]; then
    echo "── Server production tsc (--noEmit) ──"
    npx tsc -p tsconfig.production.json --noEmit 2>/dev/null
    if [ $? -ne 0 ]; then
      echo "✗ Server production build type errors — commit blocked"
      exit 1
    fi
  fi

  echo "── Client typecheck (budget) ──"
  node scripts/client-typecheck-budget.mjs
  if [ $? -ne 0 ]; then
    echo "✗ Client typecheck budget exceeded — commit blocked"
    exit 1
  fi
fi

if [ -n "$STAGED_SPEC" ]; then
  echo "── Spec typecheck (budget + zero-tolerance mines) ──"
  node scripts/spec-typecheck-budget.mjs
  if [ $? -ne 0 ]; then
    echo "✗ Spec typecheck — commit blocked"
    exit 1
  fi
fi

# 收集账本闸（2026-09-25 第三方评审裁决）: spec 或 playwright 配置变更时，
# 精确计数必须与 floor 一致——漂移（双向）不允许提交。P2/P3 加了 21 条红线
# 测试却没人同步 ledger，守卫第一次实战就抓住了自己人。合法变更 =
# 同一提交里更新 tests/e2e/.collection-floor.json。
STAGED_E2E_CFG=$(git diff --cached --name-only -- 'playwright.config.ts' 'playwright.scenario.config.ts' | head -1)
if [ -n "$STAGED_SPEC" ] || [ -n "$STAGED_E2E_CFG" ]; then
  echo "── E2e collection ledger (exact counts, ~40s) ──"
  node scripts/check-collection.mjs
  if [ $? -ne 0 ]; then
    echo "✗ Collection drift — commit blocked"
    echo "  If the change is intentional, update tests/e2e/.collection-floor.json"
    echo "  in THIS commit. Drift in EITHER direction is a ledger break."
    exit 1
  fi
fi

# 缓存键配对守卫(2026-10-13 全库审计元问题): 渲染闭包有 verify-states,
# React Query 键闭包此前零防线——撞键/悬空失效全靠人眼。静态扫描 <3s,
# 不随 staged 文件门控(键配对是跨文件性质,staged 子集无意义)
echo "── Cache-key pairing (collisions + orphan invalidations) ──"
node scripts/verify-cache-keys.mjs
if [ $? -ne 0 ]; then
  echo "✗ Cache-key violation — commit blocked"
  echo "  撞键=同一键签名被不同端点声明;悬空失效=invalidate 键不匹配任何查询键"
  exit 1
fi

# UI CSS 三层守卫（2026-11-13 I02p）：跨文件重复类基线 + 页面作用域基线。
# 背景：People.css 死规则 .insights-section... 以更高特异度覆盖 PersonDetails
# 标题色（浅色主题白字不可见）；这两条静态守卫在提交时拦截新增泄漏。
echo "── UI CSS guards (duplicates + page scope) ──"
node scripts/check-css-duplicates.mjs
if [ $? -ne 0 ]; then
  echo "✗ CSS duplicate guard — commit blocked"
  exit 1
fi

# IME Enter 守卫（I03g-W2a）：文本输入 Enter 处理点 × isImeComposing 引用。
# 单一实现在 scripts/check-ime-enter-guard.mjs（与 jest 测试共用）；staged
# client/src 时执行（全库扫描 <1s，Codex 四漏检已修）。
STAGED_CLIENT=$(git diff --cached --name-only -- 'client/src/**' | head -1)
if [ -n "$STAGED_CLIENT" ]; then
  echo "── IME Enter guard (single implementation) ──"
  node scripts/check-ime-enter-guard.mjs
  if [ $? -ne 0 ]; then
    echo "✗ IME Enter guard — commit blocked"
    exit 1
  fi

  # lint:ui 全量规则（I03g-W2b 接入：含规则 10-12 新冻结）
  echo "── lint:ui (full rules incl. freeze baselines) ──"
  node scripts/lint-ui-css.mjs
  if [ $? -ne 0 ]; then
    echo "✗ lint:ui — commit blocked"
    exit 1
  fi

  # 接线守卫（I03g-W3b）：judged 层四方互引完整（ID 锚）
  echo "── UI contract wiring (judged-layer cross-refs) ──"
  node scripts/check-ui-contract-wiring.mjs
  if [ $? -ne 0 ]; then
    echo "✗ UI contract wiring — commit blocked"
    exit 1
  fi
fi
node scripts/check-page-css-scope.mjs
if [ $? -ne 0 ]; then
  echo "✗ Page CSS scope guard — commit blocked"
  exit 1
fi

# UI 评审经验库完整性(2026-11-10 评审员试点): 每条经验必须可追溯、
# GUARD 必须有断言/自证、同族≥2 禁止 NIT、enforced 后禁止人机双源。
echo "── UI review experiences integrity ──"
node scripts/check-ui-review-experiences.mjs
if [ $? -ne 0 ]; then
  echo "✗ UI review experiences — commit blocked"
  exit 1
fi

# 后端评审经验库完整性(2026-11-11 backend-reviewer 建立): 规则与 UI 版同构。
echo "── Backend review experiences integrity ──"
node scripts/check-backend-review-experiences.mjs
if [ $? -ne 0 ]; then
  echo "✗ Backend review experiences — commit blocked"
  exit 1
fi

# 后端门禁四合(I01v 批0 地基, 2026-11-11): 审计白名单(INV-1)/审计await(INV-4)/
# 旧表写入(G2)/报表日期(G3)/调度输入写点(G-E)/数值缺省(INV-2)。经验来源 EXP-B01/B05/B07/B08；SELF_TEST 不进钩子。
echo "── Backend gates (INV-1/INV-4/G2/G3/G-E/INV-2) ──"
node scripts/check-backend-gates.mjs
if [ $? -ne 0 ]; then
  echo "✗ Backend gates — commit blocked"
  exit 1
fi

# 台账完整性(2026-11-11 四次撞号 I01o/I01q/I01s/I01t 后立项): 同表行首编号唯一、
# 跨表视图复用合法、HALVES 白名单豁免历史半边拆批。领号用 --next,接手用 --status。
echo "── Ledger integrity ──"
node scripts/check-ledger.mjs
if [ $? -ne 0 ]; then
  echo "✗ Ledger duplicate IDs — commit blocked (领号先跑 node scripts/check-ledger.mjs --next <前缀>)"
  exit 1
fi

echo "✓ pre-commit passed"
