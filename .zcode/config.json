{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "^Bash$",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${ZCODE_PROJECT_DIR}/.zcode/hooks/block-scripted-code-edits.sh\"",
              "timeoutMs": 5000,
              "statusMessage": "检查脚本化源码编辑"
            }
          ]
        }
      ]
    }
  }
}
