{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["node", "@playwright/test"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "isolatedModules": true,
    "noEmit": true,
    "module": "ES2022",
    "moduleResolution": "bundler"
  },
  "include": [
    "tests/e2e/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/e2e/archived"
  ]
}
